# henge — fastlane lanes for the iOS side.
#
# These are the front door for iOS builds; each lane wraps the same
# xcodebuild the Makefile uses, with the same two non-negotiables:
# the Xcode project is GENERATED (xcodegen runs first, always), and
# simulator builds carry CODE_SIGNING_ALLOWED=NO because SwiftPM
# resource bundles fail codesign in the simulator.
#
# `make test` (the SwiftPM oracle) stays the gate before any push;
# nothing here replaces it.

default_platform(:ios)

SCHEME = "Henge"
PROJECT = "Henge.xcodeproj"
DEVICE = "iPhone 17 Pro"
BUNDLE_ID = "io.river.henge"

# App Store Connect API key — the same key and probing order clientAPT
# uses, so a rotated key is fixed in one habit. The key's App Manager
# role lets automatic signing mint the provisioning profile during the
# archive, which is why no profile lives in this repo.
ASC_KEY_ID    = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID", "H3U2MJCD77")
ASC_ISSUER_ID = ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID",
                          "69a6de84-cb86-47e3-e053-5b8c7c11a4d1")
ASC_KEY_DIRS = [
  "~/.appstoreconnect/private_keys",
  "~/.private_keys",
  "~/Downloads"
].freeze

def asc_key_path
  ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"] ||
    ASC_KEY_DIRS
      .map { |d| File.expand_path("#{d}/AuthKey_#{ASC_KEY_ID}.p8") }
      .find { |p| File.exist?(p) }
end

def regenerate
  sh("cd .. && make generate")
end

platform :ios do
  desc "Debug build for the simulator — the factory's warning-clean check"
  lane :build do
    regenerate
    sh("cd .. && set -o pipefail; xcodebuild -project #{PROJECT} " \
       "-scheme #{SCHEME} -destination 'generic/platform=iOS Simulator' " \
       "-configuration Debug CODE_SIGNING_ALLOWED=NO build " \
       "| { grep -E 'error:|warning:|BUILD (SUCCEEDED|FAILED)' || true; }")
  end

  desc "Release build (compile proof; archiving waits on signing setup)"
  lane :release_build do
    regenerate
    sh("cd .. && set -o pipefail; xcodebuild -project #{PROJECT} " \
       "-scheme #{SCHEME} -destination 'generic/platform=iOS Simulator' " \
       "-configuration Release CODE_SIGNING_ALLOWED=NO build " \
       "| { grep -E 'error:|warning:|BUILD (SUCCEEDED|FAILED)' || true; }")
  end

  desc "Build, install and launch on the booted simulator — the visual loop"
  lane :sim do
    regenerate
    derived = "/tmp/henge-fastlane-dd"
    sh("cd .. && set -o pipefail; xcodebuild -project #{PROJECT} " \
       "-scheme #{SCHEME} -destination 'platform=iOS Simulator,name=#{DEVICE}' " \
       "-configuration Debug -derivedDataPath #{derived} " \
       "CODE_SIGNING_ALLOWED=NO build " \
       "| { grep -E 'error:|BUILD (SUCCEEDED|FAILED)' || true; }")
    sh("xcrun simctl install booted " \
       "#{derived}/Build/Products/Debug-iphonesimulator/Henge.app")
    sh("xcrun simctl terminate booted #{BUNDLE_ID} 2>/dev/null || true")
    sh("xcrun simctl launch booted #{BUNDLE_ID}")
  end

  desc "Archive, sign and upload a build to TestFlight"
  lane :beta do
    key_path = asc_key_path
    UI.user_error!("No AuthKey_#{ASC_KEY_ID}.p8 found in " \
                   "#{ASC_KEY_DIRS.join(', ')}") unless key_path

    api_key = app_store_connect_api_key(
      key_id:       ASC_KEY_ID,
      issuer_id:    ASC_ISSUER_ID,
      key_filepath: key_path,
      in_house:     false
    )

    # Register the bundle id and create the App Store Connect record on
    # first run; a no-op once they exist. Spaceship directly rather than
    # `produce`, because produce still authenticates with an Apple ID
    # session (2FA prompt) while these ConnectAPI calls ride the .p8.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ASC_KEY_ID, issuer_id: ASC_ISSUER_ID, filepath: key_path)
    unless Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
      Spaceship::ConnectAPI::BundleId.create(name: "Henge",
                                             identifier: BUNDLE_ID,
                                             platform: "IOS")
      UI.success("Registered bundle id #{BUNDLE_ID}")
    end
    # The app *record* is the one thing the API key cannot make: Apple's
    # API forbids CREATE on the apps resource, so the record is a
    # one-time human step — `fastlane produce` with an Apple ID (2FA),
    # or App Store Connect → My Apps → ＋. The lane still archives when
    # the record is missing, so signing is proven before that errand,
    # and only the upload waits on it.
    record = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    unless record
      UI.important("No App Store Connect record for #{BUNDLE_ID} yet — " \
                   "will archive and sign, then stop before upload.")
    end

    # Build numbers must only ever go up; ask TestFlight what it has.
    build_number = record ? latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    ) + 1 : 1

    regenerate
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build",
      # The project is generated, so the build number is injected as a
      # build-setting override rather than written into it.
      # Automatic signing, authenticated by the API key: the profile is
      # minted during the archive rather than checked into the repo.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} " \
              "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_path} " \
              "-authenticationKeyID #{ASC_KEY_ID} " \
              "-authenticationKeyIssuerID #{ASC_ISSUER_ID}"
    )

    unless record
      UI.user_error!(
        "Archive built and signed, but io.river.henge has no App Store " \
        "Connect record and the API key cannot create one. One-time " \
        "step, either:\n" \
        "  fastlane produce -u jeff@river.io -a io.river.henge " \
        "--app_name Henge --sku io.river.henge --language en-US\n" \
        "or App Store Connect → My Apps → ＋ (iOS, name Henge, bundle " \
        "io.river.henge, SKU io.river.henge). Then rerun: fastlane ios beta")
    end

    # External testing: the group carries a public TestFlight link, so
    # testers join from a URL rather than by collected email. Created here
    # if missing — the API key may do this, unlike the app record. The
    # first externally-distributed build goes through Apple's Beta App
    # Review before the link goes live; contact details for that review
    # are whatever App Store Connect has on file.
    group_name = "Stone Circle"
    unless record.get_beta_groups.any? { |g| g.name == group_name }
      record.create_beta_group(group_name: group_name,
                               public_link_enabled: true,
                               public_link_limit_enabled: false)
      UI.success("Created external tester group '#{group_name}' with a public link")
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      distribute_external: true,
      groups: [group_name],
      changelog: ENV["HENGE_TESTFLIGHT_NOTES"] ||
                 "The monument, the sky and the calendar — first external build.",
      reject_build_waiting_for_review: true
    )
  end

  desc "Push the App Store listing — metadata, screenshots, rating — from the repo"
  lane :store_metadata do
    key_path = asc_key_path
    UI.user_error!("No AuthKey_#{ASC_KEY_ID}.p8 found in " \
                   "#{ASC_KEY_DIRS.join(', ')}") unless key_path
    api_key = app_store_connect_api_key(
      key_id:       ASC_KEY_ID,
      issuer_id:    ASC_ISSUER_ID,
      key_filepath: key_path,
      in_house:     false
    )
    # The listing lives in fastlane/metadata (nine locales, matching the
    # app's own languages) and fastlane/screenshots (en-US only — the
    # store falls back to the primary locale's images). The version string
    # follows MARKETING_VERSION; screenshots are 6.9" iPhone and 13" iPad.
    deliver(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      app_version: "0.1.0",
      # The age rating is NOT pushed from here: Apple's 2025 declaration
      # schema (advertising, ageAssurance, …) predates this fastlane and
      # the upload fails. fastlane/rating.json records the answers; they
      # were applied with a direct PATCH to /v1/ageRatingDeclarations.
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "TEMP probe: retry app-record creation with the account's other key"
  lane :try_create do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "6SXNN2PVAB",
      issuer_id: ASC_ISSUER_ID,
      filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_6SXNN2PVAB.p8"))
    if Spaceship::ConnectAPI::App.find(BUNDLE_ID)
      UI.success("app record already exists!")
    else
      begin
        Spaceship::ConnectAPI::App.create(
          name: "Henge", version_string: "0.1.0", sku: BUNDLE_ID,
          primary_locale: "en-US", bundle_id: BUNDLE_ID, platforms: ["IOS"])
        UI.success("CREATED — the API path is open now")
      rescue => e
        UI.error("still refused: #{e.message.lines.first}")
      end
    end
  end

  desc "The pixel-level UI inspection (BuildFlowUITests) on the simulator"
  lane :uitest do
    regenerate
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      output_directory: "test_output"
    )
  end
end
