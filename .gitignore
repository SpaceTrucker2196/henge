.DS_Store

# Generated by xcodegen from project.yml — never hand-edit, never commit.
*.xcodeproj

# SwiftPM / Xcode build products
.build/
.swiftpm/
DerivedData/
# scripts/build_dmg.sh working tree and installers — artifacts live on the
# GitHub release, never in the repo.
build/
dist/
*.xcuserstate
xcuserdata/

# Resolved package versions: the package has no remote dependencies, so this
# would only ever be noise.
Package.resolved

# fastlane run artifacts — the lanes are versioned, their output is not.
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
fastlane/build/

# App Store screenshots: uploaded by `fastlane ios store_metadata`; the
# canonical copies live on App Store Connect, and 27 MB of PNG does not
# belong in history. FACTORY.md records how they were staged.
fastlane/screenshots/
